---
extends: default

rules:
  line-length:
    max: 140
  truthy:
    check-keys: false # GitHub Actions uses a bare `on:` key
  # The next three match what ansible-lint requires.
  comments-indentation: disable
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  comments:
    min-spaces-from-content: 1
